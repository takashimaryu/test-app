# Supabase の Project URL（https://xxxx.supabase.co まで。/rest/v1/ は付けない）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# LINE Login（チャネル）。サーバー専用の secret はクライアントに載せない。
# LINE Developers の Callback URL に、ブラウザで開いているオリジン + 次のパスを登録する。
# 例: http://localhost:3000/api/auth/line/callback
# 127.0.0.1 で開くなら http://127.0.0.1:3000/api/auth/line/callback も別途登録（localhost と同一扱いされない）。
# Callback URL は、アプリが LINE に送る redirect_uri と一字一句同じにする（下の LINE_REDIRECT_ORIGIN で固定も可）。
#
# .env.local に貼るときの例（値は LINE Developers Console → 該当チャネル → Basic settings）:
#   LINE_CHANNEL_ID=1234567890
#   LINE_CHANNEL_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# チャネル ID = Channel ID（数字）、チャネルシークレット = Channel secret（英数字）
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=

# 任意: LINE に送る redirect_uri のオリジンを固定する（ngrok / 本番ドメインなど）。
# 未設定なら、リクエストの Host / X-Forwarded-* から組み立てる。
# 例: LINE_REDIRECT_ORIGIN=https://abcd1234.ngrok-free.app
# LINE_REDIRECT_ORIGIN=

# OAuth 完了後に戻るサイトの土台（ローカルはこのまま、本番は Vercel の URL）
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase の Auth → Providers で作った「カスタムプロバイダの識別子」と一致（LINE は多くの場合 custom:line）
NEXT_PUBLIC_SUPABASE_OAUTH_PROVIDER=custom:line

# ローカルだけ: npm run line:oidc-jwk 用。
# Supabase → Project Settings → API →「service_role」の Reveal からコピー（anon キーでは 401 Invalid API key になる）。
# 作業後は .env.local からこの行を削除してよい。Git に載せない。
# SUPABASE_SERVICE_ROLE_KEY=

# 管理ページ（/admin）用。カンマ区切りで管理者メールを指定。
# /admin で全従業員の送信済み日報を読むため、サーバー環境変数 SUPABASE_SERVICE_ROLE_KEY も必要。
# ADMIN_EMAILS=owner@example.com,manager@example.com
